import urllib.request
import json

print("\n🐍 PYTHON CODE EXPLAINER")

code = input("\nEnter Python code: ")

while True:

    print("\n1. Explain Code")
    print("2. Find Errors")
    print("3. Improve Code")
    print("4. Exit")

    choice = input("Enter choice: ")

    if choice == "4":
        print("Goodbye!")
        break

    tasks = {
        "1": "Explain this Python code simply.",
        "2": "Find errors in this Python code and explain them.",
        "3": "Suggest improvements for this Python code."
    }

    if choice not in tasks:
        print("Invalid choice!")
        continue

    data = {
        "model": "llama3.2",
        "prompt": tasks[choice] + "\n\n" + code,
        "stream": False
    }

    try:
        request = urllib.request.Request(
            "http://localhost:11434/api/generate",
            data=json.dumps(data).encode(),
            headers={"Content-Type": "application/json"}
        )

        response = urllib.request.urlopen(request)

        result = json.loads(response.read())

        print("\n🤖 Result:")
        print(result["response"])

    except Exception as error:
        print("\n❌ Error:", error)
        print("Make sure Ollama is running.")
